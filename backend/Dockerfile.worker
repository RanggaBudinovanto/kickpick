# Builds the scraping scheduler (cmd/worker) as a separate deployable service
# from the API, so scrape run duration/load never affects HTTP request latency
# (Section 10/19 PRD: job scheduler for daily price updates).
FROM golang:1.26-alpine AS build
WORKDIR /src

RUN apk add --no-cache git

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/worker ./cmd/worker

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/worker /usr/local/bin/worker

ENTRYPOINT ["/usr/local/bin/worker"]
